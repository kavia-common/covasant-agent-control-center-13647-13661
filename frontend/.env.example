# PUBLIC_INTERFACE
# Frontend environment variables for Covasant Agent Control Tower
# Copy this file to .env and set values accordingly.

# Base URL for the backend REST API (e.g., https://api.example.com)
REACT_APP_API_BASE_URL=https://replace-with-your-api

# Optional: Request timeout in milliseconds (default 10000)
REACT_APP_API_TIMEOUT_MS=10000
